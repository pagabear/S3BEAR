# ============ App ============
APP_NAME=s3BEAR
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-secret-key!!

# ============ Database ============
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/s3bear
DATABASE_URL_SYNC=postgresql://postgres:postgres@postgres:5432/s3bear
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=s3bear
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30

# ============ Azure Entra ============
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_REDIRECT_URI=http://localhost:3000/auth/callback

# ============ AWS / S3 ============
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
# AWS_ENDPOINT_URL=http://minio:9000  # Uncomment for MinIO
S3_MAX_POOL_CONNECTIONS=64
S3_STREAM_CHUNK_SIZE_KB=1024
SHARE_ACCESS_COUNTER_SHARDS=16

# ============ Frontend (Vite) ============
VITE_AZURE_CLIENT_ID=your-client-id-here
VITE_AZURE_TENANT_ID=your-tenant-id-here
VITE_REDIRECT_URI=http://localhost:3000/auth/callback

# ============ CORS ============
ALLOWED_ORIGINS=["http://localhost:3000","https://your-domain.com"]
